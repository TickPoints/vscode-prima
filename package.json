{
  "name": "prima-lang",
  "displayName": "Prima",
  "description": "Prima language support: syntax highlighting, file icons, snippets, language configuration, and `prima check` diagnostics for .pra files.",
  "version": "0.2.0",
  "publisher": "TickPoints",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/TickPoints/vscode-prima"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "prima",
    "scientific computing",
    "symbolic math",
    "language"
  ],
  "icon": "icons/prima.png",
  "activationEvents": [
    "onLanguage:prima"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting, snippets and language configuration work in restricted mode. `prima check` executes the configured `prima` binary, and `prima.command` is a machine-scoped setting that a workspace cannot override."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "prima.checkDocument",
        "title": "Prima: Check Current File"
      },
      {
        "command": "prima.checkAll",
        "title": "Prima: Check All Open Files"
      },
      {
        "command": "prima.enableIcons",
        "title": "Prima: Enable .pra File Icons"
      },
      {
        "command": "prima.showVersion",
        "title": "Prima: Show Version"
      }
    ],
    "configuration": {
      "title": "Prima",
      "properties": {
        "prima.enable": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable `prima check` diagnostics and the status bar item."
        },
        "prima.checkOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Run `prima check` automatically when a `.pra` file is saved."
        },
        "prima.command": {
          "type": "string",
          "default": "prima",
          "scope": "machine",
          "description": "The `prima` executable path or command name used for `prima check`. Machine-scoped so a workspace cannot change which binary runs."
        }
      }
    },
    "languages": [
      {
        "id": "prima",
        "aliases": [
          "Prima",
          "prima"
        ],
        "extensions": [
          ".pra"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "prima",
        "scopeName": "source.prima",
        "path": "./syntaxes/prima.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "prima-icons",
        "label": "Prima Icons",
        "path": "./icons/prima-icon-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "prima",
        "path": "./snippets/prima.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "test": "bun run compile && bun run test:unit && bun run test:integration",
    "test:unit": "mocha --ui tdd out/test/suite",
    "test:integration": "bun ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "mocha": "^10.4.0",
    "typescript": "^5.5.0"
  }
}
